    </owl:Class>
    


    <!-- http://www.example.org/meddevice#SingleUseDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice#SingleUseDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:comment>A device intended to be used on a single individual during a single procedure.</rdfs:comment>
        <rdfs:label>Single Use Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#SoftwareRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#SoftwareRisk">
