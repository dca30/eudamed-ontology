<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/meddevice#"
     xml:base="http://www.example.org/meddevice"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:meddevice="http://www.example.org/meddevice#">
    <owl:Ontology rdf:about="http://www.example.org/meddevice">
        <owl:versionIRI rdf:resource="http://www.example.org/meddevice/1.0.0"/>
        <terms:contributor>Diego Calvo Alegre</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-26</terms:created>
        <terms:creator>Diego Calvo Alegre</terms:creator>
        <terms:description>OWL-DL ontology modelling the EUDAMED registry: medical devices, manufacturers, identified risks, reported incidents and field safety corrective actions (FSCAs).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-27</terms:modified>
        <terms:publisher>Universitat Oberta de Catalunya</terms:publisher>
        <terms:title>EUDAMED Medical Device Ontology</terms:title>
        <rdfs:comment>Ontology for the European catalogue of high-risk medical devices and in vitro diagnostic devices, under MDR (EU 2017/745) and IVDR (EU 2017/746) regulatory frameworks.</rdfs:comment>
        <rdfs:label>European Medical Device Catalogue Ontology</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/meddevice#hasClassification -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#hasClassification">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#RiskClass"/>
        <rdfs:comment>Assigns a regulatory risk class to a device.</rdfs:comment>
        <rdfs:label>has classification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#hasRisk">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Associates a device with an identified risk.</rdfs:comment>
        <rdfs:label>has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#involvesRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#involvesRisk">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Associates an incident with the risk category it materialised.</rdfs:comment>
        <rdfs:label>involves risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#isAssociatedWithIncident -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#isAssociatedWithIncident">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:comment>Links a device to a reported incident.</rdfs:comment>
        <rdfs:label>is associated with incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#isManufacturedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#isManufacturedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/meddevice#manufactures"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:comment>Relates a device to its manufacturer.</rdfs:comment>
        <rdfs:label>is manufactured by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#isSubclassifiedUnder -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#isSubclassifiedUnder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>Transitive property expressing that a risk class or device type falls within a higher classification level. Because it is transitive, if A isSubclassifiedUnder B and B isSubclassifiedUnder C, then A isSubclassifiedUnder C.</rdfs:comment>
        <rdfs:label>is subclassified under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#manufactures -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#manufactures">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:comment>Relates a manufacturer to the devices it produces.</rdfs:comment>
        <rdfs:label>manufactures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice#triggeredBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice#triggeredBy">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:comment>Links a corrective action to the incident that prompted it.</rdfs:comment>
        <rdfs:label>triggered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/meddevice#hasActionDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasActionDate">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which the corrective action was initiated.</rdfs:comment>
        <rdfs:label>has action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasAuthorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasAuthorizationNumber">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Official authorization number issued by the competent authority.</rdfs:comment>
        <rdfs:label>has authorization number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasClosureDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasClosureDate">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which the corrective action was closed.</rdfs:comment>
        <rdfs:label>has closure date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasContactEmail -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasContactEmail">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Regulatory contact email address.</rdfs:comment>
        <rdfs:label>has contact email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasCountriesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasCountriesAffected">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Countries affected by the corrective action.</rdfs:comment>
        <rdfs:label>has countries affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasCountry -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasCountry">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Country where the manufacturer is registered.</rdfs:comment>
        <rdfs:label>has country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasCountryReported -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasCountryReported">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Country where the incident was reported.</rdfs:comment>
        <rdfs:label>has country reported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasDeviceId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasDeviceId">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier of the device in the catalogue.</rdfs:comment>
        <rdfs:label>has device ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasDeviceName -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasDeviceName">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Commercial name of the device.</rdfs:comment>
        <rdfs:label>has device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasDevicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasDevicesAffected">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Scope or number of devices affected by this corrective action.</rdfs:comment>
        <rdfs:label>has devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasEUDAMED_FSCARef -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasEUDAMED_FSCARef">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>EUDAMED reference number for the FSCA.</rdfs:comment>
        <rdfs:label>has EUDAMED FSCA reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasEUDAMED_SRN -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasEUDAMED_SRN">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Single Registration Number (SRN) in EUDAMED.</rdfs:comment>
        <rdfs:label>has EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasEUDAMEM_IncidentRef -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasEUDAMEM_IncidentRef">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>EUDAMED reference number for the incident.</rdfs:comment>
        <rdfs:label>has EUDAMED incident reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasEventDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasEventDate">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which the incident occurred.</rdfs:comment>
        <rdfs:label>has event date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasFSCA_ID -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasFSCA_ID">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier of the Field Safety Corrective Action.</rdfs:comment>
        <rdfs:label>has FSCA ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasIMDRF_Code -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasIMDRF_Code">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>IMDRF terminology code classifying the risk.</rdfs:comment>
        <rdfs:label>has IMDRF code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasIncidentId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasIncidentId">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier of the incident report.</rdfs:comment>
        <rdfs:label>has incident ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasIntendedPurpose -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasIntendedPurpose">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The intended purpose of the device as stated by the manufacturer.</rdfs:comment>
        <rdfs:label>has intended purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasManufacturerId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasManufacturerId">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier of the manufacturer.</rdfs:comment>
        <rdfs:label>has manufacturer ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasManufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasManufacturerName">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Legal name of the manufacturer.</rdfs:comment>
        <rdfs:label>has manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasOutcome -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasOutcome">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description of the clinical outcome of the incident.</rdfs:comment>
        <rdfs:label>has outcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasPatientAge -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasPatientAge">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Age of the patient involved in the incident.</rdfs:comment>
        <rdfs:label>has patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasPatientSex -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasPatientSex">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Sex of the patient involved in the incident.</rdfs:comment>
        <rdfs:label>has patient sex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasProbability -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasProbability">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Probability of the risk occurring: Low, Medium, or High.</rdfs:comment>
        <rdfs:label>has probability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasRegulatoryFramework -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasRegulatoryFramework">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Regulatory framework applicable to the device: MDR or IVDR.</rdfs:comment>
        <rdfs:label>has regulatory framework</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasReportDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasReportDate">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which the incident was reported to the competent authority.</rdfs:comment>
        <rdfs:label>has report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasRiskId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasRiskId">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier of the risk.</rdfs:comment>
        <rdfs:label>has risk ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasSeverity -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasSeverity">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Severity level of the risk: Critical, Serious, or Moderate.</rdfs:comment>
        <rdfs:label>has severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasStatus -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasStatus">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Current status of the corrective action: Open or Closed.</rdfs:comment>
        <rdfs:label>has status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#hasUDI_DI -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#hasUDI_DI">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique Device Identifier – Device Identifier (UDI-DI) as registered in EUDAMED.</rdfs:comment>
        <rdfs:label>has UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#isActive -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#isActive">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the device requires an external energy source.</rdfs:comment>
        <rdfs:label>is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#isIVD -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#isIVD">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the device is an in vitro diagnostic device.</rdfs:comment>
        <rdfs:label>is IVD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#isImplantable">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the device is intended to be implanted.</rdfs:comment>
        <rdfs:label>is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/meddevice#isReusable -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/meddevice#isReusable">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the device is intended for reuse after appropriate processing.</rdfs:comment>
        <rdfs:label>is reusable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/meddevice#ActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:comment>A device whose operation depends on a source of energy other than the human body.</rdfs:comment>
        <rdfs:label>Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#ActiveImplant -->


    <owl:Class rdf:about="http://www.example.org/meddevice#ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#ImplantableDevice"/>
        <rdfs:comment>An active device that is intended to be totally or partially introduced into the human body.</rdfs:comment>
        <rdfs:label>Active Implant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#ContaminationRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#ContaminationRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk from contamination of reagents or device components.</rdfs:comment>
        <rdfs:label>Contamination Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#CorrectiveAction -->


    <owl:Class rdf:about="http://www.example.org/meddevice#CorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#MedicalEntity"/>
        <rdfs:comment>A Field Safety Corrective Action (FSCA) taken by a manufacturer to reduce the risk associated with a device.</rdfs:comment>
        <rdfs:label>Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#CybersecurityRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#CybersecurityRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk from cybersecurity vulnerabilities in connected medical devices.</rdfs:comment>
        <rdfs:label>Cybersecurity Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#Device -->


    <owl:Class rdf:about="http://www.example.org/meddevice#Device">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#MedicalEntity"/>
        <rdfs:comment>A medical device or in vitro diagnostic device registered in EUDAMED.</rdfs:comment>
        <rdfs:label>Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#DiagnosticRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#DiagnosticRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk of incorrect diagnostic result from an IVD device.</rdfs:comment>
        <rdfs:label>Diagnostic Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#IVDRRiskClass -->


    <owl:Class rdf:about="http://www.example.org/meddevice#IVDRRiskClass">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#RiskClass"/>
        <rdfs:comment>Risk class under IVDR (EU 2017/746): Class A, B, C, D.</rdfs:comment>
        <rdfs:label>IVDR Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#ActiveImplant"/>
        <rdfs:comment>An active implantable device providing therapeutic function (e.g., LVAD, CRT-D).</rdfs:comment>
        <rdfs:label>Implantable Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#ImplantableDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice#hasRisk"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A device intended to be totally or partially introduced into the human body.</rdfs:comment>
        <rdfs:label>Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#InSituCorrection -->


    <owl:Class rdf:about="http://www.example.org/meddevice#InSituCorrection">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:comment>A correction applied to a device while it remains in the field (e.g., software update, enhanced monitoring).</rdfs:comment>
        <rdfs:label>In Situ Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice#isImplantable"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A device intended to be used for examination of specimens derived from the human body.</rdfs:comment>
        <rdfs:label>In Vitro Diagnostic Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#Incident -->


    <owl:Class rdf:about="http://www.example.org/meddevice#Incident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#MedicalEntity"/>
        <rdfs:comment>A reportable event involving a medical device that has or could have led to harm.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#InfectionRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#InfectionRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk of device-related infection.</rdfs:comment>
        <rdfs:label>Infection Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#InjuryRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#InjuryRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk of direct physical harm to the patient.</rdfs:comment>
        <rdfs:label>Injury Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#InterferenceRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#InterferenceRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk from electromagnetic or imaging interference.</rdfs:comment>
        <rdfs:label>Interference Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#MDRRiskClass -->


    <owl:Class rdf:about="http://www.example.org/meddevice#MDRRiskClass">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#RiskClass"/>
        <rdfs:comment>Risk class under MDR (EU 2017/745): Class I, IIa, IIb, III.</rdfs:comment>
        <rdfs:label>MDR Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#MalfunctionRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk arising from device failure or malfunction.</rdfs:comment>
        <rdfs:label>Malfunction Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#Manufacturer -->


    <owl:Class rdf:about="http://www.example.org/meddevice#Manufacturer">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#MedicalEntity"/>
        <rdfs:comment>A legal or natural person responsible for the design, manufacture and marketing of a medical device.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#MaterialRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#MaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk from degradation of device materials (wear, corrosion).</rdfs:comment>
        <rdfs:label>Material Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#MedicalEntity -->


    <owl:Class rdf:about="http://www.example.org/meddevice#MedicalEntity">
        <rdfs:comment>Top-level class for all entities in the medical device domain.</rdfs:comment>
        <rdfs:label>Medical Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#NearMissIncident -->


    <owl:Class rdf:about="http://www.example.org/meddevice#NearMissIncident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Incident"/>
        <rdfs:comment>An event that could have resulted in patient harm but was prevented.</rdfs:comment>
        <rdfs:label>Near Miss Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#RadiationRisk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#RadiationRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#Risk"/>
        <rdfs:comment>Risk of unintended radiation exposure.</rdfs:comment>
        <rdfs:label>Radiation Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#Recall -->


    <owl:Class rdf:about="http://www.example.org/meddevice#Recall">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#CorrectiveAction"/>
        <rdfs:comment>An action to remove a device from the market or from use.</rdfs:comment>
        <rdfs:label>Recall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#Risk -->


    <owl:Class rdf:about="http://www.example.org/meddevice#Risk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice#MedicalEntity"/>
        <rdfs:comment>A potential hazard or harm associated with the use of a medical device, classified according to IMDRF nomenclature.</rdfs:comment>
        <rdfs:label>Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice#RiskClass -->


    <owl:Class rdf:about="http://www.example.org/meddevice#RiskClass">
