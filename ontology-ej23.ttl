@prefix : <http://www.example.org/meddevice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.example.org/meddevice#> .

<http://www.example.org/meddevice> rdf:type owl:Ontology ;
                                    dcterms:created "2026-04-26"^^xsd:date ;
                                    dcterms:creator """Diego Calvo Alegre
dcalvoalegre@uoc.edu""" ;
                                    dcterms:description "Models devices, manufacturers, risks, incidents and corrective actions from the EUDAMED registry." ;
                                    dcterms:title "EUDAMED Medical Device Ontology" ;
                                    rdfs:comment "Ontology for the European catalogue of high-risk medical devices and in vitro diagnostic devices, under MDR (EU 2017/745) and IVDR (EU 2017/746) regulatory frameworks." ;
                                    rdfs:label "European Medical Device Catalogue Ontology" ;
                                    owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/meddevice#hasClassification
:hasClassification rdf:type owl:ObjectProperty ;
                   rdfs:domain :Device ;
                   rdfs:range :RiskClass ;
                   rdfs:comment "Assigns a regulatory risk class to a device." ;
                   rdfs:label "has classification" .


###  http://www.example.org/meddevice#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain :Device ;
         rdfs:range :Risk ;
         rdfs:comment "Associates a device with an identified risk." ;
         rdfs:label "has risk" .


###  http://www.example.org/meddevice#involvesRisk
:involvesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :Incident ;
              rdfs:range :Risk ;
              rdfs:comment "Associates an incident with the risk category it materialised." ;
              rdfs:label "involves risk" .


###  http://www.example.org/meddevice#isAssociatedWithIncident
:isAssociatedWithIncident rdf:type owl:ObjectProperty ;
                          rdfs:domain :Device ;
                          rdfs:range :Incident ;
                          rdfs:comment "Links a device to a reported incident." ;
                          rdfs:label "is associated with incident" .


###  http://www.example.org/meddevice#isManufacturedBy
:isManufacturedBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf :manufactures ;
                  rdfs:domain :Device ;
                  rdfs:range :Manufacturer ;
                  rdfs:comment "Relates a device to its manufacturer." ;
                  rdfs:label "is manufactured by" .


###  http://www.example.org/meddevice#isSubclassifiedUnder
:isSubclassifiedUnder rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:comment "Transitive property expressing that a risk class or device type falls within a higher classification level. Because it is transitive, if A isSubclassifiedUnder B and B isSubclassifiedUnder C, then A isSubclassifiedUnder C." ;
                      rdfs:label "is subclassified under" .


###  http://www.example.org/meddevice#manufactures
:manufactures rdf:type owl:ObjectProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range :Device ;
              rdfs:comment "Relates a manufacturer to the devices it produces." ;
              rdfs:label "manufactures" .


###  http://www.example.org/meddevice#triggeredBy
:triggeredBy rdf:type owl:ObjectProperty ;
             rdfs:domain :CorrectiveAction ;
             rdfs:range :Incident ;
             rdfs:comment "Links a corrective action to the incident that prompted it." ;
             rdfs:label "triggered by" .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/meddevice#hasActionDate
:hasActionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :CorrectiveAction ;
               rdfs:range xsd:date ;
               rdfs:comment "Date on which the corrective action was initiated." ;
               rdfs:label "has action date" .


###  http://www.example.org/meddevice#hasAuthorizationNumber
:hasAuthorizationNumber rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Manufacturer ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Official authorization number issued by the competent authority." ;
                        rdfs:label "has authorization number" .


###  http://www.example.org/meddevice#hasClosureDate
:hasClosureDate rdf:type owl:DatatypeProperty ;
                rdfs:domain :CorrectiveAction ;
                rdfs:range xsd:date ;
                rdfs:comment "Date on which the corrective action was closed." ;
                rdfs:label "has closure date" .


###  http://www.example.org/meddevice#hasContactEmail
:hasContactEmail rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Manufacturer ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Regulatory contact email address." ;
                 rdfs:label "has contact email" .


###  http://www.example.org/meddevice#hasCountriesAffected
:hasCountriesAffected rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CorrectiveAction ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Countries affected by the corrective action." ;
                      rdfs:label "has countries affected" .


###  http://www.example.org/meddevice#hasCountry
:hasCountry rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "Country where the manufacturer is registered." ;
            rdfs:label "has country" .


###  http://www.example.org/meddevice#hasCountryReported
:hasCountryReported rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Country where the incident was reported." ;
                    rdfs:label "has country reported" .


###  http://www.example.org/meddevice#hasDeviceId
:hasDeviceId rdf:type owl:DatatypeProperty ;
             rdfs:domain :Device ;
             rdfs:range xsd:string ;
             rdfs:comment "Unique identifier of the device in the catalogue." ;
             rdfs:label "has device ID" .


###  http://www.example.org/meddevice#hasDeviceName
:hasDeviceName rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:string ;
               rdfs:comment "Commercial name of the device." ;
               rdfs:label "has device name" .


###  http://www.example.org/meddevice#hasDevicesAffected
:hasDevicesAffected rdf:type owl:DatatypeProperty ;
                    rdfs:domain :CorrectiveAction ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Scope or number of devices affected by this corrective action." ;
                    rdfs:label "has devices affected" .


###  http://www.example.org/meddevice#hasEUDAMED_FSCARef
:hasEUDAMED_FSCARef rdf:type owl:DatatypeProperty ;
                    rdfs:domain :CorrectiveAction ;
                    rdfs:range xsd:string ;
                    rdfs:comment "EUDAMED reference number for the FSCA." ;
                    rdfs:label "has EUDAMED FSCA reference" .


###  http://www.example.org/meddevice#hasEUDAMED_SRN
:hasEUDAMED_SRN rdf:type owl:DatatypeProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range xsd:string ;
                rdfs:comment "Single Registration Number (SRN) in EUDAMED." ;
                rdfs:label "has EUDAMED SRN" .


###  http://www.example.org/meddevice#hasEUDAMEM_IncidentRef
:hasEUDAMEM_IncidentRef rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Incident ;
                        rdfs:range xsd:string ;
                        rdfs:comment "EUDAMED reference number for the incident." ;
                        rdfs:label "has EUDAMED incident reference" .


###  http://www.example.org/meddevice#hasEventDate
:hasEventDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :Incident ;
              rdfs:range xsd:date ;
              rdfs:comment "Date on which the incident occurred." ;
              rdfs:label "has event date" .


###  http://www.example.org/meddevice#hasFSCA_ID
:hasFSCA_ID rdf:type owl:DatatypeProperty ;
            rdfs:domain :CorrectiveAction ;
            rdfs:range xsd:string ;
            rdfs:comment "Unique identifier of the Field Safety Corrective Action." ;
            rdfs:label "has FSCA ID" .


###  http://www.example.org/meddevice#hasIMDRF_Code
:hasIMDRF_Code rdf:type owl:DatatypeProperty ;
               rdfs:domain :Risk ;
               rdfs:range xsd:string ;
               rdfs:comment "IMDRF terminology code classifying the risk." ;
               rdfs:label "has IMDRF code" .


###  http://www.example.org/meddevice#hasIncidentId
:hasIncidentId rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:string ;
               rdfs:comment "Unique identifier of the incident report." ;
               rdfs:label "has incident ID" .


###  http://www.example.org/meddevice#hasIntendedPurpose
:hasIntendedPurpose rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Device ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The intended purpose of the device as stated by the manufacturer." ;
                    rdfs:label "has intended purpose" .


###  http://www.example.org/meddevice#hasManufacturerId
:hasManufacturerId rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Manufacturer ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Unique identifier of the manufacturer." ;
                   rdfs:label "has manufacturer ID" .


###  http://www.example.org/meddevice#hasManufacturerName
:hasManufacturerName rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manufacturer ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Legal name of the manufacturer." ;
                     rdfs:label "has manufacturer name" .


###  http://www.example.org/meddevice#hasOutcome
:hasOutcome rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Description of the clinical outcome of the incident." ;
            rdfs:label "has outcome" .


###  http://www.example.org/meddevice#hasPatientAge
:hasPatientAge rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:float ;
               rdfs:comment "Age of the patient involved in the incident." ;
               rdfs:label "has patient age" .


###  http://www.example.org/meddevice#hasPatientSex
:hasPatientSex rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:string ;
               rdfs:comment "Sex of the patient involved in the incident." ;
               rdfs:label "has patient sex" .


###  http://www.example.org/meddevice#hasProbability
:hasProbability rdf:type owl:DatatypeProperty ;
                rdfs:domain :Risk ;
                rdfs:range xsd:string ;
                rdfs:comment "Probability of the risk occurring: Low, Medium, or High." ;
                rdfs:label "has probability" .


###  http://www.example.org/meddevice#hasRegulatoryFramework
:hasRegulatoryFramework rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Device ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Regulatory framework applicable to the device: MDR or IVDR." ;
                        rdfs:label "has regulatory framework" .


###  http://www.example.org/meddevice#hasReportDate
:hasReportDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:date ;
               rdfs:comment "Date on which the incident was reported to the competent authority." ;
               rdfs:label "has report date" .


###  http://www.example.org/meddevice#hasRiskId
:hasRiskId rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:string ;
           rdfs:comment "Unique identifier of the risk." ;
           rdfs:label "has risk ID" .


###  http://www.example.org/meddevice#hasSeverity
:hasSeverity rdf:type owl:DatatypeProperty ;
             rdfs:domain :Risk ;
             rdfs:range xsd:string ;
             rdfs:comment "Severity level of the risk: Critical, Serious, or Moderate." ;
             rdfs:label "has severity" .


###  http://www.example.org/meddevice#hasStatus
:hasStatus rdf:type owl:DatatypeProperty ;
           rdfs:domain :CorrectiveAction ;
           rdfs:range xsd:string ;
           rdfs:comment "Current status of the corrective action: Open or Closed." ;
           rdfs:label "has status" .


###  http://www.example.org/meddevice#hasUDI_DI
:hasUDI_DI rdf:type owl:DatatypeProperty ;
           rdfs:domain :Device ;
           rdfs:range xsd:string ;
           rdfs:comment "Unique Device Identifier – Device Identifier (UDI-DI) as registered in EUDAMED." ;
           rdfs:label "has UDI-DI" .


###  http://www.example.org/meddevice#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:boolean ;
          rdfs:comment "True if the device requires an external energy source." ;
          rdfs:label "is active" .


###  http://www.example.org/meddevice#isIVD
:isIVD rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:boolean ;
       rdfs:comment "True if the device is an in vitro diagnostic device." ;
       rdfs:label "is IVD" .


###  http://www.example.org/meddevice#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:boolean ;
               rdfs:comment "True if the device is intended to be implanted." ;
               rdfs:label "is implantable" .


###  http://www.example.org/meddevice#isReusable
:isReusable rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:boolean ;
            rdfs:comment "True if the device is intended for reuse after appropriate processing." ;
            rdfs:label "is reusable" .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/meddevice#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :Device ;
              rdfs:comment "A device whose operation depends on a source of energy other than the human body." ;
              rdfs:label "Active Device" .


###  http://www.example.org/meddevice#ActiveImplant
:ActiveImplant rdf:type owl:Class ;
               rdfs:subClassOf :ActiveDevice ,
                               :ImplantableDevice ;
               rdfs:comment "An active device that is intended to be totally or partially introduced into the human body." ;
               rdfs:label "Active Implant" .


###  http://www.example.org/meddevice#ContaminationRisk
:ContaminationRisk rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "Risk from contamination of reagents or device components." ;
                   rdfs:label "Contamination Risk" .


###  http://www.example.org/meddevice#CorrectiveAction
:CorrectiveAction rdf:type owl:Class ;
                  rdfs:subClassOf :MedicalEntity ;
                  rdfs:comment "A Field Safety Corrective Action (FSCA) taken by a manufacturer to reduce the risk associated with a device." ;
                  rdfs:label "Corrective Action" .


###  http://www.example.org/meddevice#CybersecurityRisk
:CybersecurityRisk rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "Risk from cybersecurity vulnerabilities in connected medical devices." ;
                   rdfs:label "Cybersecurity Risk" .


###  http://www.example.org/meddevice#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :MedicalEntity ;
        rdfs:comment "A medical device or in vitro diagnostic device registered in EUDAMED." ;
        rdfs:label "Device" .


###  http://www.example.org/meddevice#DiagnosticRisk
:DiagnosticRisk rdf:type owl:Class ;
                rdfs:subClassOf :Risk ;
                rdfs:comment "Risk of incorrect diagnostic result from an IVD device." ;
                rdfs:label "Diagnostic Risk" .


###  http://www.example.org/meddevice#IVDRRiskClass
:IVDRRiskClass rdf:type owl:Class ;
               rdfs:subClassOf :RiskClass ;
               rdfs:comment "Risk class under IVDR (EU 2017/746): Class A, B, C, D." ;
               rdfs:label "IVDR Risk Class" .


###  http://www.example.org/meddevice#ImplantableActiveDevice
:ImplantableActiveDevice rdf:type owl:Class ;
                         rdfs:subClassOf :ActiveImplant ;
                         rdfs:comment "An active implantable device providing therapeutic function (e.g., LVAD, CRT-D)." ;
                         rdfs:label "Implantable Active Device" .


###  http://www.example.org/meddevice#ImplantableDevice
:ImplantableDevice rdf:type owl:Class ;
                   rdfs:subClassOf :Device ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasRisk ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment "A device intended to be totally or partially introduced into the human body." ;
                   rdfs:label "Implantable Device" .


###  http://www.example.org/meddevice#InSituCorrection
:InSituCorrection rdf:type owl:Class ;
                  rdfs:subClassOf :CorrectiveAction ;
                  rdfs:comment "A correction applied to a device while it remains in the field (e.g., software update, enhanced monitoring)." ;
                  rdfs:label "In Situ Correction" .


###  http://www.example.org/meddevice#InVitroDiagnosticDevice
:InVitroDiagnosticDevice rdf:type owl:Class ;
                         rdfs:subClassOf :Device ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :isImplantable ;
                                           owl:hasValue "false"^^xsd:boolean
                                         ] ;
                         rdfs:comment "A device intended to be used for examination of specimens derived from the human body." ;
                         rdfs:label "In Vitro Diagnostic Device" .


###  http://www.example.org/meddevice#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf :MedicalEntity ;
          rdfs:comment "A reportable event involving a medical device that has or could have led to harm." ;
          rdfs:label "Incident" .


###  http://www.example.org/meddevice#InfectionRisk
:InfectionRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk of device-related infection." ;
               rdfs:label "Infection Risk" .


###  http://www.example.org/meddevice#InjuryRisk
:InjuryRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "Risk of direct physical harm to the patient." ;
            rdfs:label "Injury Risk" .


###  http://www.example.org/meddevice#InterferenceRisk
:InterferenceRisk rdf:type owl:Class ;
                  rdfs:subClassOf :Risk ;
                  rdfs:comment "Risk from electromagnetic or imaging interference." ;
                  rdfs:label "Interference Risk" .


###  http://www.example.org/meddevice#MDRRiskClass
:MDRRiskClass rdf:type owl:Class ;
              rdfs:subClassOf :RiskClass ;
              rdfs:comment "Risk class under MDR (EU 2017/745): Class I, IIa, IIb, III." ;
              rdfs:label "MDR Risk Class" .


###  http://www.example.org/meddevice#MalfunctionRisk
:MalfunctionRisk rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "Risk arising from device failure or malfunction." ;
                 rdfs:label "Malfunction Risk" .


###  http://www.example.org/meddevice#Manufacturer
:Manufacturer rdf:type owl:Class ;
              rdfs:subClassOf :MedicalEntity ;
              rdfs:comment "A legal or natural person responsible for the design, manufacture and marketing of a medical device." ;
              rdfs:label "Manufacturer" .


###  http://www.example.org/meddevice#MaterialRisk
:MaterialRisk rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "Risk from degradation of device materials (wear, corrosion)." ;
              rdfs:label "Material Risk" .


###  http://www.example.org/meddevice#MedicalEntity
:MedicalEntity rdf:type owl:Class ;
               rdfs:comment "Top-level class for all entities in the medical device domain." ;
               rdfs:label "Medical Entity" .


###  http://www.example.org/meddevice#NearMissIncident
:NearMissIncident rdf:type owl:Class ;
                  rdfs:subClassOf :Incident ;
                  rdfs:comment "An event that could have resulted in patient harm but was prevented." ;
                  rdfs:label "Near Miss Incident" .


###  http://www.example.org/meddevice#RadiationRisk
:RadiationRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk of unintended radiation exposure." ;
               rdfs:label "Radiation Risk" .


###  http://www.example.org/meddevice#Recall
:Recall rdf:type owl:Class ;
        rdfs:subClassOf :CorrectiveAction ;
        rdfs:comment "An action to remove a device from the market or from use." ;
        rdfs:label "Recall" .


###  http://www.example.org/meddevice#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :MedicalEntity ;
      rdfs:comment "A potential hazard or harm associated with the use of a medical device, classified according to IMDRF nomenclature." ;
      rdfs:label "Risk" .


###  http://www.example.org/meddevice#RiskClass
:RiskClass rdf:type owl:Class ;
           rdfs:subClassOf :MedicalEntity ;
           rdfs:comment "Regulatory risk classification of a medical device according to MDR or IVDR." ;
           rdfs:label "Risk Class" .


###  http://www.example.org/meddevice#SafetyAlert
:SafetyAlert rdf:type owl:Class ;
             rdfs:subClassOf :CorrectiveAction ;
             rdfs:comment "A communication issued to inform healthcare professionals of a safety issue." ;
             rdfs:label "Safety Alert" .


###  http://www.example.org/meddevice#SelfTestDevice
:SelfTestDevice rdf:type owl:Class ;
                rdfs:subClassOf :InVitroDiagnosticDevice ;
                rdfs:comment "An IVD device intended to be used by a lay person in a home environment." ;
                rdfs:label "Self-Test Device" .


###  http://www.example.org/meddevice#SeriousIncident
:SeriousIncident rdf:type owl:Class ;
                 rdfs:subClassOf :Incident ;
                 rdfs:comment "An incident that has led to death, serious deterioration in health, or public health threat." ;
                 rdfs:label "Serious Incident" .


###  http://www.example.org/meddevice#SingleUseDevice
:SingleUseDevice rdf:type owl:Class ;
                 rdfs:subClassOf :Device ;
                 rdfs:comment "A device intended to be used on a single individual during a single procedure." ;
                 rdfs:label "Single Use Device" .


###  http://www.example.org/meddevice#SoftwareRisk
:SoftwareRisk rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "Risk arising from software malfunction or bug." ;
              rdfs:label "Software Risk" .


###  http://www.example.org/meddevice#UserNotice
:UserNotice rdf:type owl:Class ;
            rdfs:subClassOf :CorrectiveAction ;
            rdfs:comment "A formal notice issued to users with instructions to ensure continued safe use." ;
            rdfs:label "User Notice" .


#################################################################
#    Individuals
#################################################################

###  http://www.example.org/meddevice#ClassA
:ClassA rdf:type owl:NamedIndividual ,
                 :IVDRRiskClass ;
        rdfs:comment "Lowest risk class under IVDR." ;
        rdfs:label "Class A" .


###  http://www.example.org/meddevice#ClassB
:ClassB rdf:type owl:NamedIndividual ,
                 :IVDRRiskClass ;
        rdfs:comment "Low-medium risk class under IVDR." ;
        rdfs:label "Class B" .


###  http://www.example.org/meddevice#ClassC
:ClassC rdf:type owl:NamedIndividual ,
                 :IVDRRiskClass ;
        rdfs:comment "Medium-high risk class under IVDR." ;
        rdfs:label "Class C" .


###  http://www.example.org/meddevice#ClassD
:ClassD rdf:type owl:NamedIndividual ,
                 :IVDRRiskClass ;
        rdfs:comment "Highest risk class under IVDR." ;
        rdfs:label "Class D" .


###  http://www.example.org/meddevice#ClassI
:ClassI rdf:type owl:NamedIndividual ,
                 :MDRRiskClass ;
        rdfs:comment "Lowest risk class under MDR." ;
        rdfs:label "Class I" .


###  http://www.example.org/meddevice#ClassIII
:ClassIII rdf:type owl:NamedIndividual ,
                   :MDRRiskClass ;
          rdfs:comment "Highest risk class under MDR." ;
          rdfs:label "Class III" .


###  http://www.example.org/meddevice#ClassIIa
:ClassIIa rdf:type owl:NamedIndividual ,
                   :MDRRiskClass ;
          rdfs:comment "Medium-low risk class under MDR." ;
          rdfs:label "Class IIa" .


###  http://www.example.org/meddevice#ClassIIb
:ClassIIb rdf:type owl:NamedIndividual ,
                   :MDRRiskClass ;
          :isSubclassifiedUnder :ClassIII ;
          rdfs:comment "Medium-high risk class under MDR." ;
          rdfs:label "Class IIb" .


###  http://www.example.org/meddevice#DEV-001
:DEV-001 rdf:type owl:NamedIndividual ,
                  :ImplantableActiveDevice ;
         :hasClassification :ClassIII ;
         :hasRisk :RSK-003 ,
                  :RSK-004 ;
         :isAssociatedWithIncident :INC-001 ,
                                   :INC-016 ;
         :isManufacturedBy :MAN-001 ;
         :hasDeviceId "DEV-001" ;
         :hasDeviceName "HeartMate 3 LVAD" ;
         :hasIntendedPurpose "Ventricular assist device for end-stage heart failure" ;
         :hasRegulatoryFramework "MDR" ;
         :hasUDI_DI "(01)00380740009095" ;
         :isActive "true"^^xsd:boolean ;
         :isIVD "false"^^xsd:boolean ;
         :isImplantable "true"^^xsd:boolean ;
         :isReusable "false"^^xsd:boolean ;
